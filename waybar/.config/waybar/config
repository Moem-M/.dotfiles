// -*- mode: jsonc -*-
{

    "include":[
        "~/.dotfiles/waybar/.config/waybar/waybarsource/language",
        "~/.dotfiles/waybar/.config/waybar/waybarsource/workspaces",
        "~/.dotfiles/waybar/.config/waybar/waybarsource/clock",
        "~/.dotfiles/waybar/.config/waybar/waybarsource/audio",
        "~/.dotfiles/waybar/.config/waybar/waybarsource/network",
        "~/.dotfiles/waybar/.config/waybar/waybarsource/tray",
        "~/.dotfiles/waybar/.config/waybar/waybarsource/window",
        "~/.dotfiles/waybar/.config/waybar/waybarsource/bluetooth",
    ],

    "layer": "top", // Waybar at top layer
    "position": "top",
    "height": 30, // Waybar height (to be removed for auto height)
    "width": 1915, // Waybar width
    "spacing": 4, // Gaps between modules (4px)
    "reload_style_on_change": true,

    "modules-left": [
        "hyprland/workspaces",
    ],

    "modules-center": [
        "hyprland/window"
    ],

    "modules-right": [
        "pulseaudio",
        "network",
        "bluetooth",
        "clock",
        "tray",
        "hyprland/language",
    ],

}

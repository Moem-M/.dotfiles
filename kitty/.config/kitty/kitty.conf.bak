# vim:fileencoding=utf-8:foldmethod=marker

font_size 13.0

#: Terminal bell 
enable_audio_bell no

#: Color scheme 
foreground #dddddd
background #000000
#: The foreground and background colors.

background_opacity 0.9

background_tint 1.0

## BEGIN_KITTY_FONTS
font_family      family="CaskaydiaCove Nerd Font"
bold_font        auto
italic_font      auto
bold_italic_font auto
# END_KITTY_FONTS
